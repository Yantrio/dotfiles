return {
  "shaunsingh/nord.nvim",
  lazy = false,
  priority = 1000,
  config = function()
    vim.cmd "colorscheme nord"

    vim.api.nvim_set_hl(0, "LspInlayHint", {
      fg = "#616E88",
      bg = "#3B4252",
      italic = true,
    })

    vim.api.nvim_set_hl(0, "NeoTreeTabActive", {
      fg = "#88C0D0",
      bg = "#2E3440",
      bold = true,
    })

    vim.api.nvim_set_hl(0, "NeoTreeTabInactive", {
      fg = "#616E88",
      bg = "#2E3440",
    })

    vim.api.nvim_set_hl(0, "NeoTreeTabSeparatorActive", {
      fg = "#2E3440",
      bg = "#2E3440",
    })

    vim.api.nvim_set_hl(0, "NeoTreeTabSeparatorInactive", {
      fg = "#2E3440",
      bg = "#2E3440",
    })

    vim.api.nvim_set_hl(0, "WinBar", {
      fg = "#D8DEE9",
      bg = "#2E3440", -- Match Nord background
    })
    vim.api.nvim_set_hl(0, "WinBarNC", {
      fg = "#616E88",
      bg = "#2E3440",
    })
    -- Navic (breadcrumb) specific highlights if using nvim-navic
    vim.api.nvim_set_hl(0, "NavicText", {
      fg = "#D8DEE9",
      bg = "#2E3440",
    })
    vim.api.nvim_set_hl(0, "NavicSeparator", {
      fg = "#616E88",
      bg = "#2E3440",
    })
  end,
}
